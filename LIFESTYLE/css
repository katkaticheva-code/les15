@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.container {
  margin: 0 auto;
  padding: 0 20px;
  max-width: 906px;
  width: 100%;
}

a {
  text-decoration: none;
}

li {
  list-style: none;
}

:root {
  --main-color: #262626;
}

