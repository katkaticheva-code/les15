1#

class Event:
    def __init__(self, title, date):
        self.title = title
        self.date = date

    def show(self):
        print(f"Подія: {self.title}, Дата: {self.date}")

    def get_info(self):
        return f"Подія: {self.title}, Дата: {self.date}"



2#

class Training(Event):
    def __init__(self, title, date, trainer):
        super().__init__(title, date)
        self.trainer = trainer

    def show(self):
        print(f"Тренінг: {self.title}, Дата: {self.date}, Тренер: {self.trainer}")

    def get_info(self):
        return f"Тренінг: {self.title}, Дата: {self.date}, Тренер: {self.trainer}"


class Birthday(Event):
    def __init__(self, title, date, person_name):
        super().__init__(title, date)  
        self.person_name = person_name


    def show(self):
        print(f"День народження: {self.title}, Дата: {self.date}, Іменинник: {self.person_name}")

    def get_info(self):
        return f"День народження: {self.title}, Дата: {self.date}, Іменинник: {self.person_name}"



3#

events = [
    Training("Python Basics", "01.02.2026", "Іван Петренко"),
    Birthday("Святкування в офісі", "05.02.2026", "Оля"),
    Event("Конференція", "10.02.2026"),
    Training("Data Science", "15.02.2026", "Марія Коваль")
]

for event in events:
    event.show()



4#

print("\nІнформація про події (через get_info):")

for event in events:
    print(event.get_info())


